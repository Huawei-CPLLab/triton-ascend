/**
 * Multi-row (M >= 32) General Tiled GEMM sub-paths with L0B weight reuse:
 *   - gemm_m128_stationary : 8-tile (M = 128) stationary AL1 (num_k <= 3)
 *   - gemm_m32_stationary  : 2-tile (M = 32)  stationary AL1 (num_k <= 14)
 *   - gemm_m32_hybrid      : 2-tile (M = 32)  hybrid 13-cached + streaming AL1 (num_k > 14)
 */

#include "w3a16_defs.h"
#include "gemm_weight_ring.h"

namespace {

// Stationary AL1 base addresses for each of the 8 M-tiles in a 128-row block
constexpr uint64_t M128_AL1_BASES[GEMM_M128_TILES] = {
    GEN_AL1_STATIC_BASE + 0 * GEMM_M128_AL1_STRIDE,
    GEN_AL1_STATIC_BASE + 1 * GEMM_M128_AL1_STRIDE,
    GEN_AL1_STATIC_BASE + 2 * GEMM_M128_AL1_STRIDE,
    GEN_AL1_STATIC_BASE + 3 * GEMM_M128_AL1_STRIDE,
    GEN_AL1_STATIC_BASE + 4 * GEMM_M128_AL1_STRIDE,
    GEN_AL1_STATIC_BASE + 5 * GEMM_M128_AL1_STRIDE,
    GEN_AL1_STATIC_BASE + 6 * GEMM_M128_AL1_STRIDE,
    GEN_AL1_STATIC_BASE + 7 * GEMM_M128_AL1_STRIDE,
};

// Disjoint L0C ping-pong pair bases (multiples of L0C_PAIR_BYTES = 1024 B)
constexpr uint64_t M128_L0C_OFFS[GEMM_M128_TILES] = {
    0  * L0C_PAIR_BYTES,
    3  * L0C_PAIR_BYTES,
    5  * L0C_PAIR_BYTES,
    6  * L0C_PAIR_BYTES,
    7  * L0C_PAIR_BYTES,
    9  * L0C_PAIR_BYTES,
    10 * L0C_PAIR_BYTES,
    11 * L0C_PAIR_BYTES,
};

constexpr uint64_t M32_L0C_TILE1_OFF = 3 * L0C_PAIR_BYTES; // 3072 B

// Final-K MMA + Fixpipe store across all 8 M-tiles of a 128-row block (reusing L0B)
static inline [aicore] __attribute__((always_inline)) void
mma_and_store_m128_block(uint64_t prev_w, int32_t k_idx, int64_t k_tail,
                         uint64_t l0c_base, __gm__ half* out_gm,
                         int64_t n_col_off, int64_t out_16row, int64_t n_i64) {
  uint64_t mte3_ev;
  __cbuf__ half* bl1 = weight_ring_stage_prev_to_bl1(prev_w, mte3_ev);
  int64_t  l0b_cond  = static_cast<int64_t>(prev_w & 1ULL);
  uint64_t al1_k     = static_cast<uint64_t>(static_cast<int64_t>(k_idx)) * GEN_AL1_TILE_BYTES;
  bool     init_c    = (k_idx == 0);

#pragma clang loop unroll(full)
  for (int sub = 0; sub < GEMM_M128_TILES; ++sub) {
    __cc__ half* c_tile = reinterpret_cast<__cc__ half*>(l0c_base + M128_L0C_OFFS[sub]);
    cube_mma_tile_f16_tb(
        reinterpret_cast<__cbuf__ half*>(M128_AL1_BASES[sub] + al1_k),
        bl1, init_c, GEMM_M_TILE, k_tail, c_tile,
        1, sub & 1, 0, 1, UF_MODE_FINAL, (sub > 0), l0b_cond);
    fixpipe_store_tile_nz2nd(
        c_tile, out_gm, n_col_off + sub * out_16row,
        GEMM_M_TILE, GEMM_N_TILE, n_i64, UF_MODE_FINAL);
  }
  set_flag(PIPE_MTE1, PIPE_MTE3, static_cast<event_t>(mte3_ev));
}

// Inner-K accumulate MMA across a 2-tile (M = 32) pair (tile 1 reuses L0B)
static inline [aicore] __attribute__((always_inline)) void
mma_accum_m32_pair(uint64_t prev_w, bool init_c,
                   __cbuf__ half* al1_0, __cbuf__ half* al1_1,
                   uint64_t l0c_base) {
  uint64_t mte3_ev;
  __cbuf__ half* bl1 = weight_ring_stage_prev_to_bl1(prev_w, mte3_ev);
  int64_t l0b_cond   = static_cast<int64_t>(prev_w & 1ULL);

  cube_mma_tile_f16_tb(
      al1_0, bl1, init_c, GEMM_M_TILE, GEMM_K_TILE,
      reinterpret_cast<__cc__ half*>(l0c_base),
      1, 0, 0, 1, UF_MODE_ACCUM, false, l0b_cond);
  cube_mma_tile_f16_tb(
      al1_1, bl1, init_c, GEMM_M_TILE, GEMM_K_TILE,
      reinterpret_cast<__cc__ half*>(l0c_base + M32_L0C_TILE1_OFF),
      1, 1, 0, 1, UF_MODE_ACCUM, true, l0b_cond);
  set_flag(PIPE_MTE1, PIPE_MTE3, static_cast<event_t>(mte3_ev));
}

// Final-K MMA + Fixpipe store across a 2-tile (M = 32) pair (tile 1 reuses L0B)
static inline [aicore] __attribute__((always_inline)) void
mma_and_store_m32_pair(uint64_t prev_w, bool init_c, int64_t k_tail,
                       __cbuf__ half* al1_0, __cbuf__ half* al1_1,
                       uint64_t l0c_base, __gm__ half* out_gm,
                       int64_t n_col_off, int64_t out_16row, int64_t n_i64) {
  uint64_t mte3_ev;
  __cbuf__ half* bl1 = weight_ring_stage_prev_to_bl1(prev_w, mte3_ev);
  int64_t l0b_cond   = static_cast<int64_t>(prev_w & 1ULL);

  __cc__ half* c0 = reinterpret_cast<__cc__ half*>(l0c_base);
  __cc__ half* c1 = reinterpret_cast<__cc__ half*>(l0c_base + M32_L0C_TILE1_OFF);

  cube_mma_tile_f16_tb(
      al1_0, bl1, init_c, GEMM_M_TILE, k_tail,
      c0, 1, 0, 0, 1, UF_MODE_FINAL, false, l0b_cond);
  fixpipe_store_tile_nz2nd(
      c0, out_gm, n_col_off, GEMM_M_TILE, GEMM_N_TILE, n_i64, UF_MODE_FINAL);

  cube_mma_tile_f16_tb(
      al1_1, bl1, init_c, GEMM_M_TILE, k_tail,
      c1, 1, 1, 0, 1, UF_MODE_FINAL, true, l0b_cond);
  fixpipe_store_tile_nz2nd(
      c1, out_gm, n_col_off + out_16row, GEMM_M_TILE, GEMM_N_TILE, n_i64, UF_MODE_FINAL);

  set_flag(PIPE_MTE1, PIPE_MTE3, static_cast<event_t>(mte3_ev));
}

} // namespace

/**
 * Sub-Path B1: 8-Tile (M = 128) Stationary AL1 + L0B Reuse (num_k <= 3)
 */
extern "C" [aicore] __attribute__((always_inline)) int32_t
gemm_m128_stationary(__gm__ half* x_gm, __gm__ int8_t* qh_gm,
                     __gm__ int8_t* qs_gm, __gm__ half* sc_gm,
                     __gm__ half* out_gm,
                     int32_t full_m_t16, int32_t n_tiles_raw,
                     int32_t num_n, int32_t num_k, int32_t last_k_idx,
                     int64_t k_tail, int64_t k_i64, int64_t n_i64,
                     int64_t k_groups, int32_t sc_n_step_i32,
                     uint64_t& w_iter, uint64_t& c_iter) {
  constexpr uint64_t ring_mask = GEN_W_RING_SLOTS - 1;
  int32_t m_limit_8 = full_m_t16 & -GEMM_M128_TILES;
  int64_t x_16row   = k_i64 * GEMM_M_TILE;
  int64_t out_16row = n_i64 * GEMM_M_TILE;

  for (int32_t m_blk = 0; m_blk < m_limit_8; m_blk += GEMM_M128_TILES) {
    int32_t m_row0     = m_blk * static_cast<int32_t>(GEMM_M_TILE);
    int64_t x_m_base   = static_cast<int64_t>(m_row0) * k_i64;
    int64_t out_m_base = static_cast<int64_t>(static_cast<uint32_t>(m_row0)) * n_i64;

    if (n_tiles_raw > 0) {
      weight_ring_load_tile(qh_gm, qs_gm, sc_gm, 0, k_groups, w_iter & ring_mask);
    }

    // Preload all 8 x num_k activation tiles (128 x K) into AL1 using ping-pong UB
    for (int32_t k_idx = 0; k_idx < num_k; ++k_idx) {
      int64_t  x_k_off       = x_m_base + static_cast<int64_t>(k_idx * static_cast<int32_t>(GEMM_K_TILE));
      int64_t  k_cur         = (k_idx == last_k_idx) ? k_tail : GEMM_K_TILE;
      uint64_t al1_k         = static_cast<uint64_t>(static_cast<uint32_t>(k_idx)) * GEN_AL1_TILE_BYTES;
      __ubuf__ half* ub_ping = reinterpret_cast<__ubuf__ half*>(GEN_ACT_UB_PING);
      __ubuf__ half* ub_pong = reinterpret_cast<__ubuf__ half*>(GEN_ACT_UB_PONG);

      wait_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID1);
      dma_load_gm_to_ub_2d(x_gm, x_k_off + 0 * x_16row, GEMM_M_TILE, k_cur, k_i64, ub_ping, GEMM_K_TILE);
      set_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID1);

      wait_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
      dma_load_gm_to_ub_2d(x_gm, x_k_off + 1 * x_16row, GEMM_M_TILE, k_cur, k_i64, ub_pong, GEMM_K_TILE);
      set_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);

      for (int sub = 0; sub < GEMM_M128_TILES - 2; sub += 2) {
        wait_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID1);
        dma_copy_ub_to_l1_nd2nz(
            ub_ping, GEMM_M_TILE, reinterpret_cast<__cbuf__ half*>(M128_AL1_BASES[sub] + al1_k));
        set_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID1);

        wait_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID1);
        dma_load_gm_to_ub_2d(
            x_gm, x_k_off + (sub + 2) * x_16row, GEMM_M_TILE, k_cur, k_i64, ub_ping, GEMM_K_TILE);
        set_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID1);

        wait_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
        dma_copy_ub_to_l1_nd2nz(
            ub_pong, GEMM_M_TILE, reinterpret_cast<__cbuf__ half*>(M128_AL1_BASES[sub + 1] + al1_k));
        set_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);

        wait_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
        dma_load_gm_to_ub_2d(
            x_gm, x_k_off + (sub + 3) * x_16row, GEMM_M_TILE, k_cur, k_i64, ub_pong, GEMM_K_TILE);
        set_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
      }

      wait_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID1);
      dma_copy_ub_to_l1_nd2nz(
          ub_ping, GEMM_M_TILE, reinterpret_cast<__cbuf__ half*>(M128_AL1_BASES[6] + al1_k));
      set_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID1);

      wait_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
      dma_copy_ub_to_l1_nd2nz(
          ub_pong, GEMM_M_TILE, reinterpret_cast<__cbuf__ half*>(M128_AL1_BASES[7] + al1_k));
      set_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
    }

    int32_t sc_n_i32 = 0;
    for (int32_t n_idx = 0; n_idx < num_n; ++n_idx) {
      uint64_t l0c_ping   = (c_iter & 1ULL) * FRACTAL_BYTES_F16;
      int32_t  next_sc_n  = sc_n_i32 + sc_n_step_i32;
      int64_t  sc_n_base  = static_cast<int64_t>(sc_n_i32);
      bool     has_next_n = static_cast<uint32_t>(n_idx + 1) < static_cast<uint32_t>(num_n);
      bool     is_last_n  = static_cast<uint32_t>(n_idx + 1) >= static_cast<uint32_t>(num_n);

      for (int32_t k_idx = 0; k_idx < num_k; ++k_idx) {
        uint64_t cur_w    = w_iter;
        uint64_t cur_slot = cur_w & ring_mask;
        uint64_t cur_ev   = (cur_w & 1ULL) ^ 1ULL;

        weight_ring_prefetch_next(qh_gm, qs_gm, sc_gm, k_idx, num_k, has_next_n,
                                  sc_n_base, static_cast<int64_t>(next_sc_n), k_groups, cur_w);
        weight_ring_dequant_slot(cur_slot);

        if (static_cast<uint32_t>(k_idx) > 0U) {
          int32_t  prev_k = k_idx - 1;
          uint64_t prev_w = cur_w - 1ULL;
          uint64_t mte3_ev;
          __cbuf__ half* bl1 = weight_ring_stage_prev_to_bl1(prev_w, mte3_ev);
          int64_t  l0b_cond  = static_cast<int64_t>(prev_w & 1ULL);
          uint64_t al1_k     = static_cast<uint64_t>(static_cast<int64_t>(prev_k)) * GEN_AL1_TILE_BYTES;
          bool     init_c    = (prev_k == 0);
#pragma clang loop unroll(full)
          for (int sub = 0; sub < GEMM_M128_TILES; ++sub) {
            cube_mma_tile_f16_tb(
                reinterpret_cast<__cbuf__ half*>(M128_AL1_BASES[sub] + al1_k),
                bl1, init_c, GEMM_M_TILE, GEMM_K_TILE,
                reinterpret_cast<__cc__ half*>(l0c_ping + M128_L0C_OFFS[sub]),
                1, sub & 1, 0, 1, UF_MODE_ACCUM, (sub > 0), l0b_cond);
          }
          set_flag(PIPE_MTE1, PIPE_MTE3, static_cast<event_t>(mte3_ev));
        } else if (static_cast<uint32_t>(n_idx) > 0U) {
          int32_t  prev_n    = n_idx - 1;
          uint64_t prev_l0c  = l0c_ping ^ FRACTAL_BYTES_F16;
          int64_t  n_col_off = out_m_base + static_cast<int64_t>(prev_n * static_cast<int32_t>(GEMM_N_TILE));
          mma_and_store_m128_block(cur_w - 1ULL, num_k - 1, k_tail,
                                   prev_l0c, out_gm, n_col_off, out_16row, n_i64);
        }

        wait_flag(PIPE_MTE1, PIPE_MTE3, static_cast<event_t>(cur_ev));
        w_iter = cur_w + 1ULL;
      }

      if (is_last_n) {
        int64_t n_col_off = out_m_base + static_cast<int64_t>(n_idx * static_cast<int32_t>(GEMM_N_TILE));
        mma_and_store_m128_block(w_iter - 1ULL, last_k_idx, k_tail,
                                 l0c_ping, out_gm, n_col_off, out_16row, n_i64);
      }

      ++c_iter;
      sc_n_i32 = next_sc_n;
    }

    set_flag(PIPE_MTE1, PIPE_MTE3, EVENT_ID2);
    wait_flag(PIPE_MTE1, PIPE_MTE3, EVENT_ID2);
  }

  return m_limit_8;
}

/**
 * Sub-Path B2: 2-Tile (M = 32) Stationary AL1 + L0B Reuse (num_k <= 14)
 */
extern "C" [aicore] __attribute__((always_inline)) void
gemm_m32_stationary(__gm__ half* x_gm, __gm__ int8_t* qh_gm,
                    __gm__ int8_t* qs_gm, __gm__ half* sc_gm,
                    __gm__ half* out_gm,
                    int32_t m_limit_2, int32_t n_tiles_raw,
                    int32_t num_n, int32_t num_k, int32_t last_k_idx,
                    int64_t k_tail, int64_t k_i64, int64_t n_i64,
                    int64_t x_16row, int64_t out_16row,
                    int64_t k_groups, int32_t sc_n_step_i32,
                    uint64_t& w_iter, uint64_t& c_iter) {
  constexpr uint64_t ring_mask = GEN_W_RING_SLOTS - 1;

  for (int32_t m_blk = 0; m_blk < m_limit_2; m_blk += GEMM_M32_TILES) {
    int32_t m_row0     = m_blk * static_cast<int32_t>(GEMM_M_TILE);
    int64_t x_m_base   = static_cast<int64_t>(m_row0) * k_i64;
    int64_t out_m_base = static_cast<int64_t>(static_cast<uint32_t>(m_row0)) * n_i64;

    if (n_tiles_raw > 0) {
      weight_ring_load_tile(qh_gm, qs_gm, sc_gm, 0, k_groups, w_iter & ring_mask);
    }

    for (int32_t k_idx = 0; k_idx < num_k; ++k_idx) {
      int64_t  x_k_off = x_m_base + static_cast<int64_t>(k_idx * static_cast<int32_t>(GEMM_K_TILE));
      int64_t  k_cur   = (k_idx == last_k_idx) ? k_tail : GEMM_K_TILE;
      uint64_t al1_k   = static_cast<uint64_t>(static_cast<uint32_t>(k_idx)) * GEN_AL1_TILE_BYTES;
      load_act_pair_16x512_to_al1(
          x_gm, x_k_off, x_k_off + x_16row, k_cur, k_i64,
          reinterpret_cast<__cbuf__ half*>(GEMM_M32_AL1_TILE0_BASE + al1_k),
          reinterpret_cast<__cbuf__ half*>(GEMM_M32_AL1_TILE1_BASE + al1_k));
    }

    int32_t sc_n_i32 = 0;
    for (int32_t n_idx = 0; n_idx < num_n; ++n_idx) {
      uint64_t l0c_ping   = (c_iter & 1ULL) * FRACTAL_BYTES_F16;
      int32_t  next_sc_n  = sc_n_i32 + sc_n_step_i32;
      int64_t  sc_n_base  = static_cast<int64_t>(sc_n_i32);
      bool     has_next_n = static_cast<uint32_t>(n_idx + 1) < static_cast<uint32_t>(num_n);
      bool     is_last_n  = static_cast<uint32_t>(n_idx + 1) >= static_cast<uint32_t>(num_n);

      for (int32_t k_idx = 0; k_idx < num_k; ++k_idx) {
        uint64_t cur_w    = w_iter;
        uint64_t cur_slot = cur_w & ring_mask;
        uint64_t cur_ev   = (cur_w & 1ULL) ^ 1ULL;

        weight_ring_prefetch_next(qh_gm, qs_gm, sc_gm, k_idx, num_k, has_next_n,
                                  sc_n_base, static_cast<int64_t>(next_sc_n), k_groups, cur_w);
        weight_ring_dequant_slot(cur_slot);

        if (static_cast<uint32_t>(k_idx) > 0U) {
          int32_t  prev_k = k_idx - 1;
          uint64_t al1_k  = static_cast<uint64_t>(static_cast<int64_t>(prev_k)) * GEN_AL1_TILE_BYTES;
          mma_accum_m32_pair(
              cur_w - 1ULL, (prev_k == 0),
              reinterpret_cast<__cbuf__ half*>(GEMM_M32_AL1_TILE0_BASE + al1_k),
              reinterpret_cast<__cbuf__ half*>(GEMM_M32_AL1_TILE1_BASE + al1_k),
              l0c_ping);
        } else if (static_cast<uint32_t>(n_idx) > 0U) {
          int32_t  prev_n    = n_idx - 1;
          int32_t  prev_k    = num_k - 1;
          uint64_t al1_k     = static_cast<uint64_t>(static_cast<int64_t>(prev_k)) * GEN_AL1_TILE_BYTES;
          int64_t  n_col_off = out_m_base + static_cast<int64_t>(prev_n * static_cast<int32_t>(GEMM_N_TILE));
          mma_and_store_m32_pair(
              cur_w - 1ULL, (prev_k == 0), k_tail,
              reinterpret_cast<__cbuf__ half*>(GEMM_M32_AL1_TILE0_BASE + al1_k),
              reinterpret_cast<__cbuf__ half*>(GEMM_M32_AL1_TILE1_BASE + al1_k),
              l0c_ping ^ FRACTAL_BYTES_F16, out_gm, n_col_off, out_16row, n_i64);
        }

        wait_flag(PIPE_MTE1, PIPE_MTE3, static_cast<event_t>(cur_ev));
        w_iter = cur_w + 1ULL;
      }

      if (is_last_n) {
        uint64_t al1_k     = static_cast<uint64_t>(static_cast<int64_t>(last_k_idx)) * GEN_AL1_TILE_BYTES;
        int64_t  n_col_off = out_m_base + static_cast<int64_t>(n_idx * static_cast<int32_t>(GEMM_N_TILE));
        mma_and_store_m32_pair(
            w_iter - 1ULL, (last_k_idx == 0), k_tail,
            reinterpret_cast<__cbuf__ half*>(GEMM_M32_AL1_TILE0_BASE + al1_k),
            reinterpret_cast<__cbuf__ half*>(GEMM_M32_AL1_TILE1_BASE + al1_k),
            l0c_ping, out_gm, n_col_off, out_16row, n_i64);
      }

      ++c_iter;
      sc_n_i32 = next_sc_n;
    }

    set_flag(PIPE_MTE1, PIPE_MTE3, EVENT_ID2);
    wait_flag(PIPE_MTE1, PIPE_MTE3, EVENT_ID2);
  }
}

/**
 * Sub-Path B3: 2-Tile (M = 32) Hybrid 13-Cached + Streaming AL1 (num_k > 14)
 */
extern "C" [aicore] __attribute__((always_inline)) void
gemm_m32_hybrid(__gm__ half* x_gm, __gm__ int8_t* qh_gm,
                __gm__ int8_t* qs_gm, __gm__ half* sc_gm,
                __gm__ half* out_gm,
                int32_t m_limit_2, int32_t n_tiles_raw,
                int32_t num_n, int32_t num_k, int32_t last_k_idx,
                int64_t k_tail, int64_t k_i64, int64_t n_i64,
                int64_t x_16row, int64_t out_16row,
                int64_t k_groups, int32_t sc_n_step_i32,
                uint64_t& w_iter, uint64_t& c_iter) {
  constexpr uint64_t ring_mask = GEN_W_RING_SLOTS - 1;

  for (int32_t m_blk = 0; m_blk < m_limit_2; m_blk += GEMM_M32_TILES) {
    int32_t m_row0     = m_blk * static_cast<int32_t>(GEMM_M_TILE);
    int64_t x_m_base   = static_cast<int64_t>(m_row0) * k_i64;
    int64_t out_m_base = static_cast<int64_t>(static_cast<uint32_t>(m_row0)) * n_i64;

    if (n_tiles_raw > 0) {
      weight_ring_load_tile(qh_gm, qs_gm, sc_gm, 0, k_groups, w_iter & ring_mask);
    }

    int32_t sc_n_i32 = 0;
    for (int32_t n_idx = 0; n_idx < num_n; ++n_idx) {
      uint64_t l0c_ping   = (c_iter & 1ULL) * FRACTAL_BYTES_F16;
      int32_t  next_sc_n  = sc_n_i32 + sc_n_step_i32;
      int64_t  sc_n_base  = static_cast<int64_t>(sc_n_i32);
      bool     has_next_n = static_cast<uint32_t>(n_idx + 1) < static_cast<uint32_t>(num_n);
      bool     is_last_n  = static_cast<uint32_t>(n_idx + 1) >= static_cast<uint32_t>(num_n);
      bool     is_first_n = (n_idx == 0);

      for (int32_t k_idx = 0; k_idx < num_k; ++k_idx) {
        uint64_t cur_w    = w_iter;
        uint64_t cur_slot = cur_w & ring_mask;
        uint64_t cur_ev   = (cur_w & 1ULL) ^ 1ULL;

        __cbuf__ half *cur_al1_0, *cur_al1_1;
        select_hybrid_al1(static_cast<int64_t>(static_cast<uint32_t>(k_idx)),
                          cur_w, cur_al1_0, cur_al1_1);

        weight_ring_prefetch_next(qh_gm, qs_gm, sc_gm, k_idx, num_k, has_next_n,
                                  sc_n_base, static_cast<int64_t>(next_sc_n), k_groups, cur_w);
        weight_ring_dequant_slot(cur_slot);

        if (static_cast<uint32_t>(k_idx) > 0U) {
          int32_t  prev_k = k_idx - 1;
          uint64_t prev_w = cur_w - 1ULL;
          __cbuf__ half *prev_al1_0, *prev_al1_1;
          select_hybrid_al1(static_cast<int64_t>(prev_k), prev_w, prev_al1_0, prev_al1_1);
          mma_accum_m32_pair(prev_w, (prev_k == 0), prev_al1_0, prev_al1_1, l0c_ping);
        } else if (static_cast<uint32_t>(n_idx) > 0U) {
          int32_t  prev_n = n_idx - 1;
          int32_t  prev_k = num_k - 1;
          uint64_t prev_w = cur_w - 1ULL;
          __cbuf__ half *prev_al1_0, *prev_al1_1;
          select_hybrid_al1(static_cast<int64_t>(prev_k), prev_w, prev_al1_0, prev_al1_1);
          int64_t n_col_off = out_m_base + static_cast<int64_t>(prev_n * static_cast<int32_t>(GEMM_N_TILE));
          mma_and_store_m32_pair(
              prev_w, (prev_k == 0), k_tail, prev_al1_0, prev_al1_1,
              l0c_ping ^ FRACTAL_BYTES_F16, out_gm, n_col_off, out_16row, n_i64);
        }

        wait_flag(PIPE_MTE1, PIPE_MTE3, static_cast<event_t>(cur_ev));
        if (is_first_n || static_cast<uint32_t>(k_idx) >= static_cast<uint32_t>(GEMM_HYBRID_CACHED_K)) {
          int64_t x_k_off = x_m_base + static_cast<int64_t>(k_idx * static_cast<int32_t>(GEMM_K_TILE));
          int64_t k_cur   = (k_idx == last_k_idx) ? k_tail : GEMM_K_TILE;
          load_act_pair_16x512_to_al1(
              x_gm, x_k_off, x_k_off + x_16row, k_cur, k_i64, cur_al1_0, cur_al1_1);
        }
        w_iter = cur_w + 1ULL;
      }

      if (is_last_n) {
        uint64_t prev_w = w_iter - 1ULL;
        __cbuf__ half *prev_al1_0, *prev_al1_1;
        select_hybrid_al1(static_cast<int64_t>(last_k_idx), prev_w, prev_al1_0, prev_al1_1);
        int64_t n_col_off = out_m_base + static_cast<int64_t>(n_idx * static_cast<int32_t>(GEMM_N_TILE));
        mma_and_store_m32_pair(
            prev_w, (last_k_idx == 0), k_tail, prev_al1_0, prev_al1_1,
            l0c_ping, out_gm, n_col_off, out_16row, n_i64);
      }

      ++c_iter;
      sc_n_i32 = next_sc_n;
    }

    set_flag(PIPE_MTE1, PIPE_MTE3, EVENT_ID2);
    wait_flag(PIPE_MTE1, PIPE_MTE3, EVENT_ID2);
  }
}
